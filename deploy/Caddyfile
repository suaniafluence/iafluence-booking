{
	# The host's nginx terminates TLS and forwards to 127.0.0.1:${WEB_PORT}: keep its X-Forwarded-* headers.
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# Booking tokens live in the URL: never leak them through the Referer header.
		Referrer-Policy "no-referrer"
		# No third-party script or framing: a booking URL is a bearer credential.
		Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self'; script-src 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000 {
			# The visitor's address (behind the trusted nginx): rate limit of the free discovery call.
			header_up X-Real-IP {client_ip}
		}
	}

	handle /webhooks/* {
		header Cache-Control "no-store"
		reverse_proxy api:8000
	}

	# The token embedded in these paths grants access to booking information.
	@booking path_regexp booking ^/(fr|en|es)?/?reservation(/.*)?$
	header @booking Cache-Control "no-store"

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
