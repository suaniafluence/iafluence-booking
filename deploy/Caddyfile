{
	# The host's nginx terminates TLS and forwards to 127.0.0.1:${WEB_PORT}: keep its X-Forwarded-* headers.
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# Booking tokens live in the URL: never leak them through the Referer header.
		Referrer-Policy "no-referrer"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000 {
			# The visitor's address (behind the trusted nginx): rate limit of the free discovery call.
			header_up X-Real-IP {client_ip}
		}
	}

	handle /webhooks/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
