# Production: /var/www/iafluence-booking/shared/.env (chmod 600). Never commit the real file.

# Docker Compose project (prefix of containers and volumes). Default: iafluence.
# Set it to "deploy" to take over a stack previously started by hand from deploy/ (keeps its volumes).
#COMPOSE_PROJECT_NAME=iafluence

# --- Public URL ---------------------------------------------------------------
PUBLIC_BASE_URL=https://booking.iafluence.fr
# Where clients buy more hours (linked in the thank-you email after their last session).
#SHOP_URL=https://iafluence.fr
# Local port (127.0.0.1 only) the host's nginx proxies booking.iafluence.fr to.
WEB_PORT=3004

# --- PostgreSQL ---------------------------------------------------------------
# Managed Postgres (Neon): paste its URL with the "postgresql+psycopg://" scheme and leave COMPOSE_PROFILES out.
#DATABASE_URL=postgresql+psycopg://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Bundled database container instead: keep the line below and the POSTGRES_* values.
# Add ",codex" to also start the codex app-server of the session reports (see below), e.g. localdb,codex or codex.
COMPOSE_PROFILES=localdb
POSTGRES_USER=iafluence
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=iafluence

# --- Stripe (dashboard > Developers) ------------------------------------------
STRIPE_SECRET_KEY=rk_live_xxx          # restricted key: Checkout Sessions (read) + Products (read) is enough
STRIPE_WEBHOOK_SECRET=whsec_xxx        # from the webhook endpoint https://booking.iafluence.fr/webhooks/stripe
# Optional allowlist of product ids (comma-separated). Empty = any product with metadata "hours".
STRIPE_ALLOWED_PRODUCT_IDS=

# --- Google (see README: scripts/google_oauth_init.py) ------------------------
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_REFRESH_TOKEN=xxx
MAIL_FROM=votre.adresse@gmail.com      # the Gmail account that authorised the app
MAIL_FROM_NAME=Suan Tay — IAfluence
# Google sign-in of the admin and the consultants (README, step 1 bis): an OAuth client of type « Web application »
# with the redirect URI https://booking.iafluence.fr/api/auth/google/callback. Empty = GOOGLE_CLIENT_ID above.
#GOOGLE_SSO_CLIENT_ID=xxx.apps.googleusercontent.com
#GOOGLE_SSO_CLIENT_SECRET=xxx

# --- Session reports: Fireflies transcript -> Codex summary -> Gmail draft (optional) -----------------
# Needs CODEX_APP_SERVER_URL (and "codex" in COMPOSE_PROFILES), then both accounts linked from the admin:
# « Connexion Codex » (ChatGPT plan) and « Connexion Fireflies » (API key, stored encrypted with SESSION_SECRET).
# FIREFLIES_API_KEY below is only used when no key is connected from the admin.
# Fireflies: Settings > Developer settings > API key. The API is included in every plan, with a quota:
# Free 50 requests/day, Pro 500/day, Business 60/min. One request per poll covers every waiting session.
#FIREFLIES_API_KEY=xxx
# Seconds between two Fireflies checks while a transcript is awaited (default 300). Free plan: 1800.
#FIREFLIES_POLL_SECONDS=300
# No transcript after this many hours: email without summary + admin alert (default 6).
#FIREFLIES_MAX_WAIT_HOURS=6
# codex app-server of this stack (service "codex"), and the token it requires. Generate: openssl rand -hex 32
#CODEX_APP_SERVER_URL=ws://codex:4500
#CODEX_WS_TOKEN=change-me-long-random
# Optional: Codex model (empty = default of the ChatGPT plan), turn timeout, pinned Codex CLI version.
#CODEX_MODEL=
#CODEX_TURN_TIMEOUT_SECONDS=600
#CODEX_VERSION=0.159.2
# Days the summaries and infographics are kept in the database (personal data). 0 = kept. Default 90.
#REPORT_RETENTION_DAYS=90

# --- Admin (/admin) -------------------------------------------------------------
# Fallback sign-in of the admin area only (the consultant cockpit is Google-only). Leave empty to disable.
# Generate with: uv run python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('...'))"
# Keep the single quotes: the hash contains "$" characters.
ADMIN_PASSWORD_HASH='$argon2id$...'
SESSION_SECRET=change-me-long-random
COOKIE_SECURE=true
