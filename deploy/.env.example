# Copy to deploy/.env and fill in. Never commit the real file.

# --- Public URL ---------------------------------------------------------------
DOMAIN=booking.iafluence.fr
PUBLIC_BASE_URL=https://booking.iafluence.fr

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=iafluence
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=iafluence

# --- Stripe (dashboard > Developers) ------------------------------------------
STRIPE_SECRET_KEY=rk_live_xxx          # restricted key: Checkout Sessions (read) + Products (read) is enough
STRIPE_WEBHOOK_SECRET=whsec_xxx        # from the webhook endpoint https://booking.iafluence.fr/webhooks/stripe
# Optional allowlist of product ids (comma-separated). Empty = any product with metadata "hours".
STRIPE_ALLOWED_PRODUCT_IDS=

# --- Google (see README: scripts/google_oauth_init.py) ------------------------
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_REFRESH_TOKEN=xxx
MAIL_FROM=votre.adresse@gmail.com      # the Gmail account that authorised the app
MAIL_FROM_NAME=Suan Tay — IAfluence

# --- Admin (/admin) -------------------------------------------------------------
# Generate with: uv run python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('...'))"
# Keep the single quotes: the hash contains "$" characters.
ADMIN_PASSWORD_HASH='$argon2id$...'
SESSION_SECRET=change-me-long-random
COOKIE_SECURE=true
